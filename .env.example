# Copy this file to `.env` and fill in real values.
# Every setting is an environment variable (12-factor config):
# the same code runs in dev, Docker, and Kubernetes — only the env changes.

# --- Service ---
# Key that clients must send in the X-API-Key header
RAG_API_KEY=change-me

# Name shown in the X-Instance response header (used to demo load balancing)
RAG_INSTANCE_NAME=api-local

# --- Anthropic (answer generation) ---
# Get a key at https://console.anthropic.com — leave empty to run retrieval-only
ANTHROPIC_API_KEY=

# Default answer model. Use claude-haiku-4-5 during development to keep costs near zero.
RAG_ANTHROPIC_MODEL=claude-opus-5

# --- Vector store ---
# Empty = embedded local-file mode (no server needed, great for dev).
# In docker-compose / K8s this becomes http://qdrant:6333
RAG_QDRANT_URL=
RAG_QDRANT_PATH=./data/qdrant
RAG_COLLECTION=documents
